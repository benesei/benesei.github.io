<section class="anchor-pca-explainer" aria-labelledby="anchor-pca-explainer-title">
  <h3 id="anchor-pca-explainer-title">Anchor PCA in 86 seconds</h3>
  <figure>
    <video
      class="theme-video"
      controls
      playsinline
      preload="metadata"
      width="1080"
      height="1080"
      aria-label="Anchor PCA: an 86-second visual explainer"
      src="{{ '/assets/video/anchor-pca-light.mp4' | relative_url }}"
      poster="{{ '/assets/video/anchor-pca-light.jpg' | relative_url }}"
      data-light-src="{{ '/assets/video/anchor-pca-light.mp4' | relative_url }}"
      data-dark-src="{{ '/assets/video/anchor-pca-dark.mp4' | relative_url }}"
      data-light-poster="{{ '/assets/video/anchor-pca-light.jpg' | relative_url }}"
      data-dark-poster="{{ '/assets/video/anchor-pca-dark.jpg' | relative_url }}"
    >
      Your browser does not support embedded video.
      <a href="{{ '/assets/video/anchor-pca-light.mp4' | relative_url }}">Open the explainer video</a>.
    </video>
    <figcaption>A short visual introduction to Anchor PCA.</figcaption>
  </figure>
</section>
<script defer src="{{ '/assets/js/theme-video.js' | relative_url | bust_file_cache }}"></script>
